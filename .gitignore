# =============================================================================
# 1. School Tutor Data Directories
# =============================================================================

# Common reference materials & textbooks:
# Restrict all subfolders in data/common (e.g., class levels, subjects, topics, textbooks)
# while keeping README documentation tracked.
data/common/*/
!data/common/README.md
!data/common/readme.md

# Students personalized learning data:
# Restrict all student subfolders (student names, profiles, evaluations, quiz attempts)
data/students/*/

# Note: If you ever want to track student profile trackers (e.g. memory_schedule.md)
# while only ignoring the deep subject/topic subfolders, comment out data/students/*/
# and uncomment the following line instead:
# data/students/*/*/

# =============================================================================
# 2. CBSE AI Tutor Specific Protections
# =============================================================================

# Large reference textbooks (NCERT PDFs / EPUBs can be multi-megabyte files)
*.pdf
*.epub

# Secret quiz evaluation keys (generated by quiz-me agent for offline grading)
.*-key.md
*.key.md

# =============================================================================
# 3. Operating System Files
# =============================================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory

# =============================================================================
# 4. Developer Environments & IDEs
# =============================================================================

# VS Code workspace settings (keep recommended extensions, ignore local overrides)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# =============================================================================
# 5. Environment Variables, Secrets & Temporary Files
# =============================================================================

# Secrets & local environment configurations
.env
.env.local
.env.*.local
*.env

# Temporary and log files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
scratch/
temp/
tmp/

# =============================================================================
# 6. Runtimes & Package Managers (Python / Node / Archives)
# =============================================================================

# Python (common in AI / scripting workflows)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archives (prevent accidental textbook zip commits)
*.zip
*.tar.gz
*.rar
*.7z
